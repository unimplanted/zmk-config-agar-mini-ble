#include "./boards/shields/klink_kbd/common.keymap"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&gresc      &kp Q      &kp W     &kp E  &kp R   &kp T  &kp Y      &kp U  &kp I      &kp O           &kp P                &mt LGUI BACKSLASH  &kp BSPC
&bt BT_NXT  &kp A      &kp S     &kp D  &kp F   &kp G  &kp H      &kp J  &kp K      &kp L           &kp SEMI             &kp RET
&kp LSHFT   &kp Z      &kp X     &kp C  &kp V   &kp B  &kp N      &kp M  &kp COMMA  &kp DOT         &mt RSHIFT UP_ARROW  &trans
            &kp LCTRL  &kp LALT         &trans         &kp SPACE                    &kp LEFT_ARROW  &kp DOWN_ARROW
            >;
        };
    };
};
